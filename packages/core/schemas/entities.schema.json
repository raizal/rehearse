{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "rehearse:entities",
  "title": "rehearse entities.yaml (R2, D21)",
  "type": "object",
  "required": ["entities"],
  "additionalProperties": false,
  "properties": {
    "entities": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "fields"],
        "additionalProperties": false,
        "properties": {
          "id": { "type": "string", "pattern": "^[A-Z][A-Za-z0-9]*$" },
          "about": { "type": "string" },
          "fields": {
            "type": "object",
            "minProperties": 1,
            "additionalProperties": { "type": "string", "minLength": 1 }
          },
          "lifecycle": {
            "type": "object",
            "required": ["field", "initial", "transitions"],
            "additionalProperties": false,
            "properties": {
              "field": { "type": "string" },
              "initial": { "type": "string" },
              "transitions": {
                "type": "array",
                "items": {
                  "type": "object",
                  "required": ["from", "to", "by"],
                  "additionalProperties": false,
                  "properties": {
                    "from": { "type": "string" },
                    "to": { "type": "string" },
                    "by": { "type": "string" },
                    "when": { "type": "string" }
                  }
                }
              }
            }
          }
        }
      }
    }
  }
}
