{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "rehearse:prd",
  "title": "rehearse prd.yaml (R2)",
  "type": "object",
  "required": ["epic", "roles", "requirements", "stories"],
  "additionalProperties": false,
  "properties": {
    "epic": {
      "type": "object",
      "required": ["slug", "title", "goal"],
      "additionalProperties": false,
      "properties": {
        "slug": { "type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}-[a-z0-9]+(-[a-z0-9]+)*$" },
        "title": { "type": "string", "minLength": 1 },
        "goal": { "type": "string", "minLength": 1 },
        "successMeasure": { "type": "string" },
        "outOfScope": { "type": "array", "items": { "type": "string" } }
      }
    },
    "roles": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "name", "kind"],
        "additionalProperties": false,
        "properties": {
          "id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]*$" },
          "name": { "type": "string" },
          "kind": { "enum": ["human", "agent", "system", "external"] },
          "about": { "type": "string" }
        }
      }
    },
    "requirements": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "kind", "text"],
        "additionalProperties": false,
        "properties": {
          "id": { "type": "string", "pattern": "^R[0-9]+$" },
          "kind": { "enum": ["functional", "performance", "security", "permission"] },
          "text": { "type": "string", "minLength": 1 },
          "provenBy": { "type": "string", "minLength": 1 }
        },
        "if": { "properties": { "kind": { "not": { "const": "functional" } } }, "required": ["kind"] },
        "then": { "required": ["provenBy"] }
      }
    },
    "stories": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "role", "want", "soThat", "requirements", "acceptance"],
        "additionalProperties": false,
        "properties": {
          "id": { "type": "string", "pattern": "^S[0-9]+$" },
          "role": { "type": "string" },
          "want": { "type": "string", "minLength": 1 },
          "soThat": { "type": "string", "minLength": 1 },
          "requirements": { "type": "array", "minItems": 1, "items": { "type": "string" } },
          "acceptance": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "required": ["id", "given", "when", "then"],
              "additionalProperties": false,
              "properties": {
                "id": { "type": "string", "pattern": "^S[0-9]+-A[0-9]+$" },
                "given": { "type": "string" },
                "when": { "type": "string" },
                "then": { "type": "string" },
                "expectedState": { "type": "object" }
              }
            }
          }
        }
      }
    },
    "resolvedQuestions": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["question", "answer"],
        "additionalProperties": false,
        "properties": {
          "question": { "type": "string" },
          "answer": { "type": "string" },
          "at": { "type": "string" }
        }
      }
    }
  }
}
