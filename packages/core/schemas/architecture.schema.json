{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "rehearse:architecture",
  "title": "rehearse EPIC architecture.yaml: what the EPIC adds to, changes in and removes from docs/system/ (D4, D43)",
  "type": "object",
  "required": ["version"],
  "additionalProperties": false,
  "properties": {
    "version": { "const": 1 },
    "about": { "type": "string" },
    "zones": { "type": "array", "items": { "$ref": "#/definitions/zoneChange" } },
    "components": { "type": "array", "items": { "$ref": "#/definitions/componentChange" } },
    "links": { "type": "array", "items": { "$ref": "#/definitions/linkChange" } },
    "boxes": { "type": "array", "items": { "$ref": "#/definitions/boxNote" } },
    "entities": { "type": "array", "items": { "$ref": "#/definitions/entityNote" } }
  },
  "definitions": {
    "id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]*$" },
    "change": { "enum": ["added", "changed", "removed"] },
    "why": {
      "$comment": "Decision ids (G2, D19) that cause the change.",
      "type": "array",
      "minItems": 1,
      "items": { "type": "string", "pattern": "^[A-Z]+[0-9]+$" }
    },
    "stories": { "type": "array", "items": { "type": "string", "minLength": 1 } },
    "stringList": { "type": "array", "items": { "type": "string", "minLength": 1 } },
    "color": { "enum": ["blue", "purple", "green", "amber", "grey"] },
    "zoneChange": {
      "type": "object",
      "required": ["id", "change", "why"],
      "additionalProperties": false,
      "properties": {
        "id": { "$ref": "#/definitions/id" },
        "change": { "$ref": "#/definitions/change" },
        "name": { "type": "string", "minLength": 1 },
        "about": { "type": "string" },
        "trust": { "type": "string" },
        "color": { "$ref": "#/definitions/color" },
        "planned": { "type": "boolean" },
        "what": { "type": "string" },
        "why": { "$ref": "#/definitions/why" },
        "stories": { "$ref": "#/definitions/stories" }
      },
      "if": { "properties": { "change": { "const": "added" } } },
      "then": { "required": ["name"] }
    },
    "componentChange": {
      "type": "object",
      "required": ["id", "change", "why"],
      "additionalProperties": false,
      "properties": {
        "id": { "$ref": "#/definitions/id" },
        "change": { "$ref": "#/definitions/change" },
        "name": { "type": "string", "minLength": 1 },
        "kind": { "enum": ["component", "store", "person", "outside"] },
        "zone": { "type": "string" },
        "about": { "type": "string" },
        "code": { "$ref": "#/definitions/stringList" },
        "color": { "$ref": "#/definitions/color" },
        "planned": { "type": "boolean" },
        "what": { "type": "string" },
        "why": { "$ref": "#/definitions/why" },
        "stories": { "$ref": "#/definitions/stories" }
      },
      "if": { "properties": { "change": { "const": "added" } } },
      "then": { "required": ["name"] }
    },
    "linkChange": {
      "type": "object",
      "required": ["from", "to", "change", "why"],
      "additionalProperties": false,
      "properties": {
        "from": { "type": "string" },
        "to": { "type": "string" },
        "change": { "$ref": "#/definitions/change" },
        "label": { "type": "string" },
        "what": { "type": "string" },
        "why": { "$ref": "#/definitions/why" },
        "stories": { "$ref": "#/definitions/stories" }
      }
    },
    "boxNote": {
      "$comment": "Why a box of this EPIC's flow.yaml is added or changed, or a box of docs/system/flow.yaml that this EPIC removes.",
      "type": "object",
      "required": ["path", "why"],
      "additionalProperties": false,
      "properties": {
        "path": { "type": "string", "minLength": 1 },
        "change": { "const": "removed" },
        "title": { "type": "string" },
        "what": { "type": "string" },
        "why": { "$ref": "#/definitions/why" },
        "stories": { "$ref": "#/definitions/stories" }
      }
    },
    "entityNote": {
      "type": "object",
      "required": ["id", "why"],
      "additionalProperties": false,
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "change": { "const": "removed" },
        "what": { "type": "string" },
        "why": { "$ref": "#/definitions/why" },
        "stories": { "$ref": "#/definitions/stories" }
      }
    }
  }
}
