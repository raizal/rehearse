{
  "name": "@rehearse/ui",
  "version": "0.1.0",
  "private": true,
  "description": "The rehearse review UI: swimlanes, drill-down and scenario playback (D31, D32). `rehearse serve` serves dist/.",
  "type": "module",
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "vite build",
    "dev": "vite",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "coverage": "vitest run --coverage --coverage.reporter=lcov --coverage.reporter=text-summary --coverage.include=src/**"
  },
  "dependencies": {
    "@xyflow/react": "^12.12.1",
    "elkjs": "^0.12.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@rehearse/core": "workspace:*",
    "@rehearse/server": "workspace:*",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.8",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.2.1",
    "jsdom": "^30.1.3",
    "vite": "^8.3.5"
  }
}
