{
  "name": "@rehearse/server",
  "version": "0.1.0",
  "description": "Read-only HTTP server for the rehearse UI. Listens on 127.0.0.1 only (R20).",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": { "types": "./dist/index.d.ts", "default": "./dist/index.js" }
  },
  "files": ["dist"],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@rehearse/core": "workspace:*"
  }
}
